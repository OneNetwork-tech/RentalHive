# Copy to .env and fill in. Never commit .env.

# Database password (generate: openssl rand -base64 24)
POSTGRES_PASSWORD=
POSTGRES_DB=rentalhive
POSTGRES_USER=rentalhive

# 32-byte master key protecting personnummer at rest (generate: openssl rand -base64 32).
# Losing or changing it makes stored personnummer unreadable - back it up in your secret store.
Security__PersonalNumberKey=

# JWT signing key for the REST API, at least 32 characters (generate: openssl rand -base64 48)
Jwt__Key=
Jwt__Issuer=RentalHive
Jwt__Audience=RentalHive.Clients

# Origins allowed to call the API from browsers (leave unset for same-origin/native clients only)
# Cors__Origins__0=https://app.example.se

# If you run behind a reverse proxy, list its IPs so X-Forwarded-* headers are trusted
# ForwardedHeaders__KnownProxies__0=10.0.0.10

WEB_PORT=8080
API_PORT=8081

# HTTPS-only cookies, HSTS and redirect (default true). Set false only to test over plain HTTP on a LAN.
# Security__HttpsOnly=true

# Server settings for deploy/docker-compose.yml. Copy to .env next to it. Never commit .env.

# Image to run: latest (default branch), a branch name (e.g. claude-charming-noether-lhy664) or sha-<7 chars>
IMAGE_TAG=claude-charming-noether-lhy664
HOST_PORT=3001

# Required. Generate with: openssl rand -hex 48 / openssl rand -base64 24
JWT_SECRET=d2bf5396c9419392953574f1e11dd2c8f412b340df85f5d1abd86025a3cf4c0a77fb252970af31dcc221ede172659c42
POSTGRES_PASSWORD=da2821f424f53b3a3a352cf2ebd9a776

# Host folder with your movies/series/music (mounted at /media)
MEDIA_PATH=./media

# Plain HTTP on a LAN: keep false. Set true once a TLS reverse proxy is in front.
HTTPS_ONLY=false
TRUST_PROXY=loopback

ALLOW_REGISTRATION=false
TRANSCODING_ENABLED=true
MAX_TRANSCODES=2
SCAN_ON_STARTUP=false
# Optional metadata: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Behind an HTTPS reverse proxy on this server (see Caddyfile.example) ---
# Uncomment all three, and comment out HTTPS_ONLY=false and TRUST_PROXY=loopback above.
# HTTPS_ONLY=true
# Trust the proxy for client IPs (rate limiting). Docker networks use 172.16.0.0/12
# by default (check with: docker network inspect salmanplex_default).
# TRUST_PROXY=loopback, 172.16.0.0/12
# Only the proxy can reach the app; plain http://<server-ip>:3001 stops working.
# BIND_ADDRESS=127.0.0.1

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,csproj,css,js,razor}]
indent_size = 2

# EF Core migrations are generated code.
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
